# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Evidence Guard
APP_ENV=development
DEBUG=false
# REQUIRED – generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_real_secret_key_here
FRONTEND_ORIGIN=http://localhost:5173

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=eg_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=evidence_guard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── MinIO (object storage for encrypted evidence files) ────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=eg_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password
MINIO_BUCKET=evidence-guard
MINIO_SECURE=false

# ── Encryption master key ─────────────────────────────────────────────────────
# REQUIRED – 32-byte hex key for wrapping per-case data keys.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# In production: mount from a secrets manager or HSM; never store in .env.
MASTER_KEY_HEX=CHANGE_ME_64_hex_chars_here

# ── JWT / Auth ─────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ISSUER=EvidenceGuard

# ── Blockchain ─────────────────────────────────────────────────────────────────
# Options: fabric | ethereum | mock
LEDGER_PLATFORM=mock
FABRIC_GATEWAY_HOST=localhost
FABRIC_GATEWAY_PORT=7051
ETH_RPC_URL=http://localhost:8545
ETH_CONTRACT_ADDRESS=

# ── AI service ─────────────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=
AI_MAX_INPUT_BYTES=10485760

# ── Upload limits ──────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=2147483648
